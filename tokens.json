{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Nodal",
  "color": {
    "graphite": {
      "$type": "color",
      "$value": "#0B0C0A",
      "$description": "Primary background"
    },
    "graphite2": {
      "$type": "color",
      "$value": "#151713",
      "$description": "Raised surfaces"
    },
    "rule": {
      "$type": "color",
      "$value": "#32362C",
      "$description": "Lines and borders on dark"
    },
    "paper": {
      "$type": "color",
      "$value": "#ECEAE2",
      "$description": "Text and mark on dark"
    },
    "muted": {
      "$type": "color",
      "$value": "#8D8B81",
      "$description": "Secondary text on dark"
    },
    "lime": {
      "$type": "color",
      "$value": "#C6F135",
      "$description": "Signal — one accent per composition"
    },
    "limeInk": {
      "$type": "color",
      "$value": "#1B2400",
      "$description": "Text on lime"
    },
    "ink": {
      "$type": "color",
      "$value": "#121211",
      "$description": "Text and mark on light"
    },
    "paperLight": {
      "$type": "color",
      "$value": "#F3F1EA",
      "$description": "Light background (docs, print)"
    }
  },
  "typography": {
    "wordmark": {
      "family": "Inter",
      "weight": 600,
      "tracking": "0.12em",
      "case": "uppercase",
      "license": "SIL Open Font License 1.1"
    },
    "labels": {
      "family": "JetBrains Mono",
      "weight": "400–500",
      "case": "uppercase, 0.12em tracking",
      "license": "SIL Open Font License 1.1"
    },
    "alternatives": {
      "wordmark": "IBM Plex Sans SemiBold",
      "labels": "IBM Plex Mono"
    }
  },
  "logo": {
    "clearSpace": "x = checkpoint size = 3/16 of mark height, on every side",
    "minimumSize": {
      "mark": "16px",
      "lockup": "96px wide (recommended 140px or more)"
    }
  }
}
